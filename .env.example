# Copy to .env and adjust. No API keys are needed: CodeMind AI only talks to a local Ollama server.

# --- Ollama / LLM ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
LLM_ENABLED=true
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
LLM_CONTEXT_LENGTH=8192

# --- Repair loop ---
MAX_REPAIR_ATTEMPTS=3

# --- Isolated validation (Docker) ---
SANDBOX_ENABLED=true
SANDBOX_IMAGE=codemind-sandbox:latest
SANDBOX_TIMEOUT=20
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_OUTPUT_LIMIT=20000

# --- Storage ---
HISTORY_ENABLED=true
# DATABASE_URL=sqlite:///data/codemind.db

# --- Limits / logging ---
MAX_CODE_CHARS=30000
MAX_CODE_LINES=800
STATIC_ANALYSIS_TIMEOUT=60
LOG_LEVEL=INFO
